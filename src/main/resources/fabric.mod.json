{
	"schemaVersion": 1,
	"id": "sillyserver",
	"version": "${version}",
	"name": "sillyserver",
	"description": "Cosmetics for sillyserver",
	"authors": [
		"palight"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sillyserver/icon.png",
	"environment": "*",
	"entrypoints": {
